# =============================================================================
# PhishGuard / BnB — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets/
creds/
*.pem
*.key

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# -----------------------------------------------------------------------------
# Testing / coverage / type-checking / linting caches
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
hypothesis/

# -----------------------------------------------------------------------------
# Machine-learning & data artifacts
# (datasets, trained models, feeds, calibrated policies — all reproducible)
# -----------------------------------------------------------------------------
*.onnx
*.lgbm
*.joblib
*.pkl
*.h5
*.pt
*.pth
*.parquet
*.feather
*.arrow

# PhishGuard data directories: keep the folders, ignore their contents
phishguard/data/raw/*
phishguard/data/processed/*
phishguard/data/feeds/*
!phishguard/data/.gitkeep
!phishguard/data/raw/.gitkeep
!phishguard/data/processed/.gitkeep
!phishguard/data/feeds/.gitkeep

# -----------------------------------------------------------------------------
# PhishGuard runtime state
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
phishguard/data/profiles.db
*.log
logs/

# -----------------------------------------------------------------------------
# Node / React dashboard
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.cache/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# -----------------------------------------------------------------------------
# Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Docker / local overrides
# -----------------------------------------------------------------------------
docker-compose.override.yml
*.override.yml

# -----------------------------------------------------------------------------
# OS / editor cruft
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
*.orig
*.rej
