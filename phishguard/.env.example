MAIL_DOMAIN=demo.local
MAIL_ADMIN_USER=admin@demo.local
MAIL_ADMIN_PASS=changeme
DOVECOT_MASTER_USER=backend
DOVECOT_MASTER_PASS=changeme
SQLITE_PATH=/data/phishguard.db
LOG_LEVEL=INFO
# No Ollama/LLM runtime needed — all models run via ONNX
TEXT_MODEL=cybersectony/phishing-email-detection-distilbert_v2.1
SECURITY_ENCODER=ehsanaghaei/SecureBERT
URL_PHISH_MODEL=ealvaradob/bert-finetuned-phishing

# --- Optional shared multi-tester tracking (MongoDB Atlas free tier) ---
# Leave MONGODB_URI empty to disable shared tracking (the default).
# Example: MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Your identity in the shared database (e.g. initials or name). Defaults to the host name.
TESTER_ID=
# Database name (default: phishguard).
MONGODB_DB=phishguard
# NOTE: on deployed systems you can instead drop a creds/atlas-credentials.env file into
# phishguard/ — it is auto-detected and git-ignored. See creds/atlas-credentials.env.example.
